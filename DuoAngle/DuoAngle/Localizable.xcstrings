        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発を応援"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발 후원"
          }
        }
      }
    },
    "目标角度数据无法读取": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target angle data couldn't be read"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取目標角度資料"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標角度データを読み込めません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 각도 데이터를 읽을 수 없습니다"
          }
        }
      }
    },
    "原有数据仍已保留。重置后可重新添加目标角度。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your existing data is preserved. Reset to add target angles again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原有資料仍會保留。重設後即可重新新增目標角度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のデータは保持されています。リセットすると目標角度を追加し直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 데이터는 보존됩니다. 재설정하면 목표 각도를 다시 추가할 수 있습니다."
          }
        }
      }
    },
    "重置目标角度": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Target Angles"
          }
