        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 목표 각도가 없습니다"
          }
        }
      }
    },
    "点击右上角 + 添加目标角度": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + in the top-right to add a target angle"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選右上角的 + 以新增目標角度"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の＋をタップして目標角度を追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 위의 +를 눌러 목표 각도를 추가하세요"
          }
        }
      }
    },
