        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 iPhone 모델은 아직 검증되지 않았습니다. 호환성이 확인될 때까지 각도 측정을 사용할 수 없습니다." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "有度尚未驗證此 iPhone 機型，確認相容性前暫不提供角度測量。" } }
