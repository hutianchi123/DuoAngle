      }
    },
    "感谢你的支持，让好奇心继续生长。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks for your support. It keeps curiosity growing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感謝你的支持，讓好奇心繼續成長。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応援ありがとうございます。好奇心がこれからも育ちます。"
