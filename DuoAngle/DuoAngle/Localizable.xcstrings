            "state": "translated",
            "value": "재설정하고 손상된 데이터 지우기"
          }
        }
      }
    },
    "此操作会删除无法读取的原始目标角度数据。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the unreadable original target angle data."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作會刪除無法讀取的原始目標角度資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込めない元の目標角度データを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽을 수 없는 기존 목표 각도 데이터를 삭제합니다."
          }
        }
      }
    },
    "角度必须在 0° 到 180° 之间。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Angle must be between 0° and 180°."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "角度必須介於 0° 到 180° 之間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "角度は0°から180°の範囲で指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각도는 0°에서 180° 사이여야 합니다."
          }
        }
      }
    },
    "这个目标角度已存在，请选择其他角度。": {
      "extractionState": "manual",
