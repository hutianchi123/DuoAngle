    "尚未确认设备兼容性" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Device compatibility not confirmed" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "デバイスの互換性は未確認です" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "기기 호환성이 확인되지 않았습니다" } },
