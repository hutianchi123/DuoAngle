{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "请展开以测量角度": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the hinge to measure the angle"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請展開以測量角度"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒンジを開くと角度を測定できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "힌지를 펼쳐 각도를 측정하세요"
          }
        }
      }
    },
    "角度暂不可用": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Angle unavailable"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "角度暫時無法使用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "角度を取得できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각도를 사용할 수 없습니다"
          }
        }
      }
    },
    "当前角度，%lld 度": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current angle: %lld degrees"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前角度：%lld 度"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の角度：%lld度"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 각도: %lld도"
          }
        }
      }
    },
    "当前角度，%lld 度，已达到目标角度": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current angle: %lld degrees. Target reached."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前角度：%lld 度，已達到目標角度"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の角度：%lld度。目標角度に到達しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 각도: %lld도. 목표 각도에 도달했습니다"
          }
        }
      }
    },
    "设定角度": {
      "extractionState": "manual",
      "localizations": {
