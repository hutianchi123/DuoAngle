    "有度尚未验证此 iPhone 机型。确认兼容性前，角度测量功能暂不可用。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "FoldMetry has not verified this iPhone model. Angle measurement is unavailable until compatibility is confirmed." } },
